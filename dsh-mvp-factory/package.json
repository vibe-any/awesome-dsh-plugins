{
  "name": "dsh-mvp-factory",
  "version": "0.1.0",
  "description": "AI product factory for DeepSeek Harness: discover product ideas with the configured web search, score and plan them with the configured model, hand the build prompt to the dsh conversation, then run the produced app locally.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "build": "npm run typecheck && tsdown"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.5.4"
  }
}
